    {
      "name": "06 - Payments",
      "item": [
        {
          "name": "Initiate Payment (TEST_SUCCESS)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderId\": \"{{createdOrderId}}\",\n  \"userId\": \"{{customerId}}\",\n  \"amount\": 799.98,\n  \"paymentMethod\": \"TEST_SUCCESS\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/payments",
              "host": ["{{baseUrl}}"],
              "path": ["api", "payments"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var json = pm.response.json();",
                  "pm.test('Payment status is SUCCESS', function () {",
                  "    pm.expect(json.status).to.eql('SUCCESS');",
                  "});",
                  "pm.test('Transaction reference is generated', function () {",
                  "    pm.expect(json.transactionReference).to.be.a('string');",
                  "});",
                  "if (json.id) {",
                  "    pm.environment.set('paymentId', json.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
