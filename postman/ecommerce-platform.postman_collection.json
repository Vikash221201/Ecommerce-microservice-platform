    {
      "name": "07 - Security Boundary Checks",
      "item": [
        {
          "name": "Customer Attempt to Create Product (Expect 403)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Illicit Product\",\n  \"price\": 1.00\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/products",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Customer product creation forbidden (403)', function () {",
                  "    pm.response.to.have.status(403);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Unauthenticated Cart Access (Expect 401)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/cart/any-user-id",
              "host": ["{{baseUrl}}"],
              "path": ["api", "cart", "any-user-id"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
